{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./build",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "./src/index.ts",
    "./src/bootstrap/**/*.ts",
    "./src/component/**/*.ts",
    "./src/store/**/*.ts",
    "./src/runtime/**/*.ts",
    "./src/connect/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "tests",
    "examples",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
